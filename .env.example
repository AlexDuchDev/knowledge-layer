# Copy to .env and adjust. Never commit real secrets.
#
# Runtime validation: apps/api/internal/config/hardening.go (ValidateAPI, ValidateWorker)
#
# Default URLs below match this repo's docker-compose.yml published host ports when you run
# `make db-up` / `docker compose up -d postgres redis opensearch` and run the API on the host
# (`cd apps/api && go run ./cmd/api` on port API_PORT, default 8080).
# If you run Postgres/Redis/OpenSearch on standard ports instead, override DATABASE_URL / REDIS_URL / OPENSEARCH_URL.

APP_ENV=local
API_PORT=8080
DATABASE_URL=postgres://knowledge:knowledge@localhost:25432/knowledge?sslmode=disable
OPENSEARCH_URL=http://localhost:19200
# Staging/production: use https:// to OpenSearch, or set OPENSEARCH_ALLOW_INSECURE_HTTP=1 on private networks only.
# Local compose uses http:// on localhost — set 1 here for local; set empty/0 when pointing staging at https OpenSearch.
OPENSEARCH_ALLOW_INSECURE_HTTP=1
REDIS_URL=redis://localhost:16379

# --- Neo4j (GraphRAG / knowledge graph) ---
# Defaults match docker-compose.yml published host ports when running compose locally.
NEO4J_URL=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Blob storage (optional). Default: nop (bytes discarded; URI still returned).
# BLOBSTORE_BACKEND=s3
# BLOBSTORE_S3_ENDPOINT=localhost:9000
# BLOBSTORE_S3_REGION=us-east-1
# BLOBSTORE_S3_BUCKET=knowledge-artifacts
# BLOBSTORE_S3_ACCESS_KEY=
# BLOBSTORE_S3_SECRET_KEY=
# BLOBSTORE_S3_USE_SSL=false
# BLOBSTORE_S3_PATH_STYLE=true

# --- API auth ---
# development_header: LOCAL/DEV ONLY (X-Principal-User-ID). Staging/production MUST use session.
AUTH_MODE=development_header
SESSION_SECRET=
# Session cookie Secure: unset = secure for APP_ENV=staging|production; false/0/no = insecure (blocked when APP_ENV=production)
SESSION_COOKIE_SECURE=
ALLOW_SELF_REGISTRATION=false
APP_PUBLIC_URL=http://localhost:3000

# First workspace (API startup): when there are zero domains, the API can create admin + default domain automatically.
# Local (APP_ENV=local): enabled by default; set AUTO_BOOTSTRAP_INSTANCE=0 to force manual POST /instance/bootstrap instead.
# Staging/production: off unless AUTO_BOOTSTRAP_INSTANCE=1 — then set BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD (min 8 chars).
# AUTO_BOOTSTRAP_INSTANCE=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_DOMAIN_NAME=
# Staging/production: comma-separated origins; required in process env
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Ops / metrics (Authorization: Bearer <token>) ---
# Local: optional; if set, same bearer rules as non-local for /ops/health.
# Staging: optional for API startup. If UNSET: /ops/health is redacted without auth; /metrics returns 401 (no anonymous scrape).
# Production: REQUIRED (min 16 characters after trim); startup fails if missing/short.
OPS_AUTH_TOKEN=
BUILD_VERSION=dev

# Worker health endpoints (Phase 2 hardening). Each worker boots a small HTTP
# server alongside its Asynq processor:
#   /health      — always-public liveness ({"status":"ok"})
#   /ops/health  — full snapshot (DB ping, Redis ping, queue depths, last
#                  processed timestamps); bearer-gated by OPS_AUTH_TOKEN
#                  outside APP_ENV=local (same rules as the API endpoint).
JOBWORKER_HEALTH_PORT=:9001
CONNECTORWORKER_HEALTH_PORT=:9002

# Connector webhooks (Phase 2.2.3 + Mattermost follow-up — OSS).
# The webhook route POST /connectors/webhook/:adapter_kind/:source_feed_id is
# always mounted; per-feed secrets live INSIDE connector_config_json, not in env.
#
# Slack (Events API, HMAC-SHA256):
#   {
#     "bot_token":      "xoxb-...",
#     "signing_secret": "8f742231b10e8888abcd99yyyzzz85a5",
#     "feed_kind":      "channel"
#   }
#
# Mattermost (Outgoing Webhook, shared token):
#   {
#     "mattermost_base_url":    "https://mm.example.com",
#     "mattermost_token":       "<personal-access-token>",
#     "outgoing_webhook_token": "mm-token-deadbeef-..."
#   }
#
# Without the matching auth field configured the route returns 503 — never
# accept unsigned/untokened deliveries.

# SMTP (invitations / test mail); leave empty to log emails only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Web (Next.js) ---
# Host `npm run dev`: point at your API (often 8080). Docker Compose web image: build args use API_HOST_PORT (default 18080) — see docker-compose.yml + Dockerfile.web.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Production/staging: MUST be false; session login only
NEXT_PUBLIC_USE_DEV_HEADER=true
NEXT_PUBLIC_PRINCIPAL_USER_ID=30000000-0000-0000-0000-000000000001
# Optional: enables in-app “read full doc” links (GitHub UI path ending at /docs, no trailing slash)
# NEXT_PUBLIC_DOCS_BASE_URL=https://github.com/your-org/your-repo/blob/main/docs

# --- OpenAI / LLM backend (real OpenAI or compatible gateway) ---
# OPENAI_API_KEY: use when not using OpenRouter (chat + embeddings via OPENAI_BASE_URL).
# If OPENROUTER_API_KEY is set below, OPENAI_API_KEY can stay empty.
# If you want a local/offline dev mode, set OPENAI_MOCK=1 (deterministic, no network).
OPENAI_API_KEY=
# OPENAI_BASE_URL: origin only (no "/v1" suffix).
# Examples:
# - https://api.openai.com (default)
# - http://127.0.0.1:8080 (for OpenAI-compatible self-hosted gateways)
OPENAI_BASE_URL=https://api.openai.com
# Chat model used for Ask/synthesis.
OPENAI_MODEL=gpt-4o-mini
# Embeddings model used by semantic/hybrid retrieval.
# Must be compatible with the client's expected embedding dimension (defaults to text-embedding-3-small).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_MOCK=1 uses mock mode (no external calls). Leave empty/0 for real OpenAI.
OPENAI_MOCK=

# Transcription for Ask `audio_base64` (optional; see docs/CONFIG_ENV.md).
# OpenAI path: multipart /v1/audio/transcriptions
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- OpenRouter (OpenAI-compatible gateway) ---
# If OPENROUTER_API_KEY is set, the backend will use OpenRouter instead of OPENAI_*.
# Chat: text + optional multimodal user parts on Ask (image_url, transcribed audio merged into question first).
# Embeddings: text-only. Documents: ingestion → text → chunks (same as OpenAI path).
# Transcription on OpenRouter uses chat/completions + input_audio (not OpenAI’s /audio/transcriptions).
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# Base URL must include /api/v1 (default below).
#
# SECURITY: Never commit real keys to git. This file must contain placeholders only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers (helps identify your app in OpenRouter analytics/leaderboards).
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=
OPENROUTER_CATEGORIES=

# Scenario → model overrides (optional).
# Example: AI_MODEL_SCENARIO_ASK_ENTITY=openai/gpt-5.2
# Key format: AI_MODEL_SCENARIO_<SCENARIO> where <SCENARIO> is uppercased and non-alnum -> '_'
# (e.g. \"ai_summarize\" -> AI_MODEL_SCENARIO_AI_SUMMARIZE)
AI_MODEL_SCENARIO_ASK_ENTITY=
AI_MODEL_SCENARIO_ASK_GLOBAL=
AI_MODEL_SCENARIO_AI_SUMMARIZE=
AI_MODEL_SCENARIO_AI_DRAFT_SUGGESTIONS=

# --- AI privacy vault (placeholder → value at rest for rehydration) ---
# Production: 32-byte key as raw string or base64. Local/tests: AI_PRIVACY_DEV_PLAINTEXT_STORE=1 (never in prod).
AI_PRIVACY_VAULT_KEY=
AI_PRIVACY_DEV_PLAINTEXT_STORE=1

# --- Second Brain overlay (optional; see docs/CONFIG_ENV.md, docs/SECOND_BRAIN_BOTS.md) ---
# SECOND_BRAIN_WEBHOOK_SECRET=
# TELEGRAM_BOT_TOKEN=
# SECOND_BRAIN_BOT_SCENARIO_CODE=
# MATTERMOST_OUTGOING_WEBHOOK_TOKEN=
# SECOND_BRAIN_PREBRIEF_TICK=0

# --- OAuth connector onboarding (Gmail + Microsoft 365) ---
# Browser-reachable API base used for OAuth redirect_uri. If unset, falls back to APP_PUBLIC_URL.
# API_PUBLIC_URL=http://localhost:8080
# After OAuth callback, the API redirects to this URL and appends ?oauth_sid=...
# OAUTH_WEB_REDIRECT_URL=http://localhost:3000/source-feeds
#
# Gmail OAuth client (Google Cloud Console). Required for refresh-token based sync.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
#
# Microsoft OAuth client (Azure app registration). Tenant defaults to "common".
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT=common
